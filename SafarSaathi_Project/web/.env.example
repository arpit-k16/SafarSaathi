# Leave empty when the console is served by the SafarSaathi backend itself (Docker/Render)
# or when using `npm run dev` (Vite proxies /api to http://127.0.0.1:8000).
# Set to the public HTTPS URL of the API only when hosting the console separately (e.g. Vercel):
# VITE_SAFARSAATHI_API_URL=https://safarsaathi.onrender.com
VITE_SAFARSAATHI_API_URL=
